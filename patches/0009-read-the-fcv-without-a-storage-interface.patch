+    // An embedded server installs no replication StorageInterface: it never replicates, and its
+    // startup recovery writes no FCV document for this to find. Reading the parameter has to say
+    // so rather than dereference the missing interface, which took the host process down on
+    // `getParameter: {featureCompatibilityVersion: 1}` -- one of the first things mongosh asks.
+    // The caller falls back to the in-memory FCV, which is the one the server was started with.
+    auto* storageInterface = repl::StorageInterface::get(opCtx);
+    if (!storageInterface) {
+        return {ErrorCodes::NoSuchKey,
+                "FCV document not read: this server has no replication storage interface"};
+    }
