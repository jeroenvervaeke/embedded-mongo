--- a/src/mongo/platform/throw_hook.h
+++ b/src/mongo/platform/throw_hook.h
@@ -21,9 +21,34 @@ namespace mongo {
  * The __do_catch call in the implementation is part of the Linux C++
  * ABI, but not part of the C++ standard.
  */
+#ifdef _LIBCPP_VERSION
+namespace __cxxabiv1 {
+/**
+ * libc++abi's implementation of std::type_info. Its can_catch() is the counterpart of
+ * libstdc++'s __do_catch(); libc++abi keeps the declaration in a private header, so it is
+ * repeated here. Nothing constructs one and no virtual is defined here, so no vtable for
+ * this class is emitted.
+ */
+class __shim_type_info : public std::type_info {
+public:
+    ~__shim_type_info() override;
+    virtual void noop1() const;
+    virtual void noop2() const;
+    virtual bool can_catch(const __shim_type_info* thrown_type, void*& adjustedPtr) const;
+};
+}  // namespace __cxxabiv1
+#endif
+
 template <typename T>
 T* catchCast(std::type_info* tinfo, void* obj) {
+#ifdef _LIBCPP_VERSION
+    const auto* target = static_cast<const __cxxabiv1::__shim_type_info*>(&typeid(T));
+    const auto* thrown = static_cast<const __cxxabiv1::__shim_type_info*>(
+        static_cast<const std::type_info*>(tinfo));
+    return target->can_catch(thrown, obj) ? static_cast<T*>(obj) : nullptr;
+#else
     return typeid(T).__do_catch(tinfo, &obj, 1) ? static_cast<T*>(obj) : nullptr;
+#endif
 }
 
