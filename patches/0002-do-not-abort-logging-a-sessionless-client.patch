+namespace {
+/**
+ * Client::getRemote() verifies that a session exists. A client created in-process by an
+ * embedded server has none, so asking it for a remote address aborts the whole process -- on
+ * the first hello, which is the first thing a driver sends. Logging must not be what does that.
+ */
+HostAndPort clientRemoteOrEmpty(Client* client) {
+    return client->hasRemote() ? client->getRemote() : HostAndPort();
+}
