#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
environment=${PYMONGO_EMBEDDED_ENV:-"$repo_root/.cache/python"}
pymongo_source=${PYMONGO_SOURCE:-"$repo_root/../mongo-python-driver"}
python_bin=${PYTHON_BIN:-python3}

if [ ! -f "$pymongo_source/pymongo/__init__.py" ]; then
    echo "PyMongo source not found at $pymongo_source; set PYMONGO_SOURCE" >&2
    exit 1
fi
if [ ! -x "$environment/venv/bin/python" ]; then
    "$python_bin" -m venv "$environment/venv"
fi

cargo build --release -p embedded-mongodb-python --manifest-path "$repo_root/Cargo.toml"

package="$environment/site/pymongo_embedded"
mkdir -p "$package"
for source in __init__.py client.py pool.py; do
    ln -sfn "$repo_root/python/pymongo_embedded/$source" "$package/$source"
done

# The extension records a bare `libembedded_mongodb_native.so` with no RUNPATH, so it needs
# the loader pointed at whichever copy this build actually used. That is the one the build
# script placed in OUT_DIR -- which nowadays is usually a downloaded library, not a bazel
# output -- so ask the build tree rather than assuming.
# Newest first: a target directory keeps the build output of every fingerprint it has ever
# had, and an older one would be a different library.
native_dir=${EMBEDDED_MONGODB_NATIVE_LIB_DIR:-$(dirname "$(ls -t \
    "$repo_root"/target/release/build/embedded-mongodb-sys-*/out/libembedded_mongodb_native.so \
    2>/dev/null | head -1)")}
if [ ! -f "$native_dir/libembedded_mongodb_native.so" ]; then
    echo "native library not found under target/release/build; run cargo build --release" >&2
    exit 1
fi
case $(uname -s) in
    Darwin)
        extension="$repo_root/target/release/lib_native.dylib"
        export DYLD_LIBRARY_PATH="$native_dir${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
        ;;
    *)
        extension="$repo_root/target/release/lib_native.so"
        export LD_LIBRARY_PATH="$native_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        ;;
esac
ln -sfn "$extension" "$package/_native.abi3.so"

export PYTHONPATH="$environment/site:$pymongo_source${PYTHONPATH:+:$PYTHONPATH}"
if [ "$#" -eq 0 ]; then
    set -- "$repo_root/examples/python/basic.py"
fi
exec "$environment/venv/bin/python" "$@"
