#!/bin/sh
# Regenerates embedded-mongodb-sys/prebuilt.rs from a directory of built release assets.
#
#   scripts/write-prebuilt-manifest <release-tag> <source-commit> <dist-dir>
#
# <dist-dir> holds one libembedded_mongodb_native-<target>.so per published target, each
# with a <target>.sha256 sidecar in sha256sum format and an optional <target>.glibc holding
# the minimum host glibc as "<major>.<minor>". The publish job runs this; run it by hand to
# recover a manifest for a release that was published without one.
set -eu

if [ "$#" -ne 3 ]; then
    echo "usage: $0 <release-tag> <source-commit> <dist-dir>" >&2
    exit 2
fi
tag=$1
source_commit=$2
dist=$3

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
manifest="$repo_root/embedded-mongodb-sys/prebuilt.rs"

# A short commit would still resolve, but build.rs prints it in every staleness message and
# a full one is what `git rev-parse HEAD` gives the workflow.
case $source_commit in
    ????????????????????????????????????????) ;;
    *) echo "source commit must be 40 hex characters, got '$source_commit'" >&2; exit 1 ;;
esac

# Written to a temporary first: a half-generated manifest that still parses is worse than no
# manifest, because it would compile.
temporary="$manifest.tmp.$$"
trap 'rm -f "$temporary"' EXIT

cat > "$temporary" <<EOF
// @generated by scripts/write-prebuilt-manifest -- do not edit by hand.
//
// Which published native libraries this checkout is entitled to download, and the exact
// bytes each one must have. The expected digests come from git rather than from the network,
// so replacing a release asset cannot go unnoticed.
//
// Regenerate by running the \`native\` workflow, which builds the engine, publishes a release
// and commits the result back.

/// Release holding the assets below.
const RELEASE_TAG: &str = "$tag";
/// Repository commit CI built them from. \`build.rs\` compares this checkout's native inputs
/// against it and refuses to use a library that no longer matches.
const SOURCE_COMMIT: &str = "$source_commit";
const BASE_URL: &str = "https://github.com/jeroenvervaeke/embedded-mongo/releases/download";

static PREBUILT: &[Prebuilt] = &[
EOF

found=0
# Sorted, so an unchanged set of assets regenerates byte-identically and the commit-back is
# a no-op rather than a reordering.
for library in $(ls "$dist"/libembedded_mongodb_native-*.so | sort); do
    asset=$(basename "$library")
    target=${asset#libembedded_mongodb_native-}
    target=${target%.so}

    checksum_file="$dist/$target.sha256"
    if [ ! -f "$checksum_file" ]; then
        echo "missing $checksum_file for $asset" >&2
        exit 1
    fi
    checksum=$(cut -d' ' -f1 < "$checksum_file")
    case $checksum in
        ????????????????????????????????????????????????????????????????) ;;
        *) echo "$checksum_file does not hold a sha256 digest" >&2; exit 1 ;;
    esac
    # Recompute rather than trust the sidecar: it is the whole point of the manifest, and the
    # cost is one pass over 33 MB.
    actual=$(sha256sum "$library" | cut -d' ' -f1)
    if [ "$actual" != "$checksum" ]; then
        echo "$asset hashes to $actual, but $checksum_file says $checksum" >&2
        exit 1
    fi
    size=$(wc -c < "$library" | tr -d ' ')

    glibc_min=None
    if [ -s "$dist/$target.glibc" ]; then
        floor=$(tr -d ' \n' < "$dist/$target.glibc")
        major=${floor%%.*}
        minor=${floor#*.}
        case $major.$minor in
            [0-9]*.[0-9]*) glibc_min="Some(($major, $minor))" ;;
            *) echo "$dist/$target.glibc holds '$floor', want <major>.<minor>" >&2; exit 1 ;;
        esac
    fi

    cat >> "$temporary" <<EOF
    Prebuilt {
        target: "$target",
        asset: "$asset",
        sha256: "$checksum",
        size: $size,
        glibc_min: $glibc_min,
    },
EOF
    found=$((found + 1))
done

if [ "$found" -eq 0 ]; then
    echo "no libembedded_mongodb_native-*.so found in $dist" >&2
    exit 1
fi

echo '];' >> "$temporary"
mv "$temporary" "$manifest"
trap - EXIT
echo "wrote $manifest: $found target(s) for $tag"
